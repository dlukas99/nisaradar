    {
      "@type": "dcat:Distribution",
      "dct:title": "Metapodaci i sažetak (JSON)",
      "dcat:accessURL": { "@id": "https://dlukas99.github.io/nisaradar/data/meta.json" },
      "dcat:mediaType": { "@id": "https://www.iana.org/assignments/media-types/application/json" },
      "dct:conformsTo": { "@id": "https://github.com/dlukas99/nisaradar/blob/main/docs/openapi.yaml" }
    },
    {
      "@type": "dcat:Distribution",
      "dct:title": "Semafor po JLS-u (JSON, jedna datoteka po JLS-u)",
      "dcat:accessURL": { "@id": "https://dlukas99.github.io/nisaradar/data/deficit/" },
      "dcat:mediaType": { "@id": "https://www.iana.org/assignments/media-types/application/json" },
      "dct:conformsTo": { "@id": "https://github.com/dlukas99/nisaradar/blob/main/docs/openapi.yaml" }
    },
    {
      "@type": "dcat:Distribution",
      "dct:title": "Semafor po odjeljku NKD 2025 (JSON, jedna datoteka po odjeljku)",
